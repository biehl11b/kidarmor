{
  "appId": "com.coastlinecode.kidarmor",
  "appName": "KidArmor",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "errorPath": "webview-update.html"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 80
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#1f5d70"
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#1f5d70",
      "showSpinner": false
    }
  }
}